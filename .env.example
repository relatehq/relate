# Local Postgres on port 5433. Create both databases before running these commands.
# The example applies migrations and retains data in this database.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/relate

# Dedicated disposable database. Integration tests reset its relate schema.
# Never point this at the development database or another application's database.
RELATE_TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/relate_test
