{
  "name": "@relate/inspector",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "description": "Developer inspector: a live model graph served by relate dev.",
  "files": [
    "dist",
    "README.md",
    "SPEC.md"
  ],
  "sideEffects": false,
  "exports": {
    "./protocol": {
      "types": "./dist/server/protocol.d.ts",
      "import": "./dist/server/protocol.js"
    },
    "./server": {
      "types": "./dist/server/server.d.ts",
      "import": "./dist/server/server.js"
    }
  },
  "scripts": {
    "build": "pnpm build:server && pnpm build:client",
    "build:server": "tsc -b tsconfig.server.json",
    "build:client": "vite build",
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "hono": "4.13.13",
    "relate": "workspace:*",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-router": "1.170.41",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@xyflow/react": "12.12.0",
    "elkjs": "0.12.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vite": "8.3.3"
  }
}
