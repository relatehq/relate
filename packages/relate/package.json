{
  "name": "relate",
  "version": "0.0.0-dev.0",
  "license": "Apache-2.0",
  "private": false,
  "type": "module",
  "description": "Ontology authoring, portable application definitions, model contracts, and compilation.",
  "files": [
    "dist",
    "README.md",
    "CONTRACT.md"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./compiler": {
      "types": "./dist/compiler.d.ts",
      "import": "./dist/compiler.js"
    },
    "./model": {
      "types": "./dist/model.d.ts",
      "import": "./dist/model.js"
    },
    "./diagnostics": {
      "types": "./dist/diagnostics.d.ts",
      "import": "./dist/diagnostics.js"
    }
  },
  "dependencies": {
    "@relate/protocol": "workspace:*",
    "zod": "4.6.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
