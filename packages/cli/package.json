{
  "name": "@relate/cli",
  "version": "0.0.0-dev.0",
  "license": "Apache-2.0",
  "private": false,
  "type": "module",
  "description": "Development and operational commands using programmatic APIs.",
  "bin": {
    "relate": "./bin/relate.js"
  },
  "files": [
    "bin",
    "dist/bin.*",
    "dist/index.*",
    "dist/commands",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@relate/dev": "workspace:*",
    "relate": "workspace:*",
    "@relate/inspector": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1"
  }
}
