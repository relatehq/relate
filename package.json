{
  "name": "relate-workspace",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": "^26.9.0"
  },
  "scripts": {
    "packages": "pnpm -r list --depth -1",
    "build": "tsc -b packages/protocol packages/relate packages/runtime packages/postgres packages/node",
    "typecheck": "pnpm build && tsc --noEmit -p tsconfig.tests.json",
    "test": "pnpm build && dotenvx run -f .env -- vitest run",
    "check:boundaries": "node tests/boundaries.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm check:boundaries && pnpm test && pnpm test:packaging",
    "test:packaging": "pnpm build && node tests/packaging/verify.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "pnpm lint:fix && prettier --write .",
    "format:check": "prettier --check .",
    "example:hello-world": "pnpm build && tsx examples/hello-world/src/index.ts",
    "example:postgres": "pnpm build && dotenvx run -f .env -- tsx examples/postgres-persistence/src/index.ts",
    "test:integration": "pnpm build && dotenvx run -f .env -- vitest run --project integration",
    "test:unit": "pnpm build && vitest run --project unit",
    "worktree:create": "tsx scripts/worktrees/create.ts",
    "worktree:delete": "tsx scripts/worktrees/delete.ts",
    "worktree:list": "tsx scripts/worktrees/list.ts",
    "changeset": "changeset",
    "release:prepare": "node scripts/releases/prepare.mjs",
    "release:artifacts": "node scripts/releases/artifacts.mjs",
    "test:release": "node --test scripts/releases/release.test.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@dotenvx/dotenvx": "2.28.0",
    "@hono/node-server": "2.1.3",
    "@relate/node": "workspace:*",
    "@relate/postgres": "workspace:*",
    "@relate/protocol": "workspace:*",
    "@relate/runtime": "workspace:*",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "26.6.4",
    "@types/pg": "8.23.1",
    "@typescript-eslint/parser": "8.71.0",
    "eslint": "10.12.0",
    "hono": "4.13.13",
    "pg": "8.23.1",
    "prettier": "3.9.9",
    "relate": "workspace:*",
    "semver": "7.8.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.3",
    "zod": "4.6.5"
  }
}
