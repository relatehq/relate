{
  "name": "relate-workspace",
  "version": "0.0.0-dev.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": "^22.16.0 || ^24 || ^26"
  },
  "scripts": {
    "packages": "pnpm -r list --depth -1",
    "build": "tsc -b packages/protocol packages/relate packages/runtime packages/postgres packages/node connectors/sqlite connectors/stripe apps/inspector/tsconfig.server.json packages/cli && pnpm --filter @relate/inspector build:client",
    "docs:dev": "pnpm --filter @relate/docs dev",
    "docs:build": "pnpm --filter @relate/docs build",
    "example:hello-world": "node scripts/examples/run.mjs hello-world",
    "example:postgres": "node scripts/examples/run.mjs postgres",
    "check": "pnpm check:development && pnpm format:check && pnpm lint && pnpm typecheck && pnpm check:boundaries && pnpm test && pnpm test:packaging",
    "typecheck": "pnpm build && tsc --noEmit -p tsconfig.tests.json",
    "check:boundaries": "node --import tsx tests/boundaries.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "pnpm lint:fix && prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm build && dotenvx run -f .env -- vitest run",
    "test:unit": "pnpm build && vitest run --project unit",
    "test:integration": "pnpm build && dotenvx run -f .env -- vitest run --project integration",
    "test:packaging": "pnpm build && node tests/packaging/verify.mjs",
    "test:release": "node --test scripts/releases/release.test.mjs",
    "changeset": "node scripts/releases/changeset.mjs",
    "release:prepare": "node scripts/releases/prepare.mjs",
    "release:artifacts": "node scripts/releases/artifacts.mjs",
    "worktree:create": "tsx scripts/worktrees/create.ts",
    "worktree:list": "tsx scripts/worktrees/list.ts",
    "worktree:delete": "tsx scripts/worktrees/delete.ts",
    "example:customer-accounts": "node scripts/examples/run.mjs customer-accounts",
    "check:development": "node scripts/releases/check-development.mjs",
    "example:customer-workspace": "node scripts/examples/run.mjs customer-workspace",
    "test:onboarding": "node --test scripts/examples/process.test.mjs tests/onboarding/smoke.test.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@dotenvx/dotenvx": "2.28.0",
    "@relate/cli": "workspace:*",
    "@relate/connector-sqlite": "workspace:*",
    "@relate/connector-stripe": "workspace:*",
    "@relate/dev-crm-simulator": "workspace:*",
    "@relate/inspector": "workspace:*",
    "@relate/node": "workspace:*",
    "@relate/postgres": "workspace:*",
    "@relate/protocol": "workspace:*",
    "@relate/runtime": "workspace:*",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@typescript-eslint/parser": "8.71.0",
    "eslint": "10.12.0",
    "pg": "8.23.1",
    "prettier": "3.9.9",
    "relate": "workspace:*",
    "semver": "7.8.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.3",
    "zod": "4.6.5"
  }
}
