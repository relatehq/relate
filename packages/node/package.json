{
  "name": "@relate/node",
  "version": "0.0.0-dev.0",
  "license": "Apache-2.0",
  "private": false,
  "type": "module",
  "description": "Node application composition for typed, authorized reads and native actions.",
  "dependencies": {
    "relate": "workspace:*",
    "@relate/runtime": "workspace:*",
    "@relate/protocol": "workspace:*"
  },
  "files": [
    "dist",
    "README.md",
    "CONTRACT.md",
    "NATIVE_ACTIONS.md"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
